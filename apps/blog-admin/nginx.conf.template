# /etc/nginx/conf.d/blog_admin.conf
# 1. 업스트림 정의 (이름을 blog_admin_group으로 지정)
upstream blog_service_group {
    include /etc/nginx/conf.d/blog_admin_target.inc;
}

server {
    listen 80;
    server_name admin.example.com;

    location / {
        # 2. 위에서 정의한 이름을 그대로 사용
        proxy_pass http://blog_admin_group;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}