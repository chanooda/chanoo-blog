# /etc/nginx/conf.d/blog_service.conf
# 1. 업스트림 정의 (이름을 blog_service_group으로 지정)
upstream blog_service_group {
    include /etc/nginx/conf.d/blog_service_target.inc;
}

server {
    listen 443 ssl;
    server_name chanoo.dev;

    # 1. 민감한 파일(.env, .git 등) 접근 차단
    location ~ /\.(env|git|ht|config) {
        deny all;
    }

    # 2. 불필요한 PHP 또는 실행 파일 경로 차단
    location ~* \.(php|aspx|jsp|cgi|exe)$ {
        deny all;
    }

    # 3. 특정 공격 패턴 (phpunit, wp-admin 등) 차단
    location ~* /(vendor|phpunit|wp-admin|wp-content|xmlrpc\.php) {
        deny all;
    }

    location / {
        # 2. 위에서 정의한 이름을 그대로 사용
        proxy_pass http://blog_service_group;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}